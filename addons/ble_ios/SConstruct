#!/usr/bin/env python
import os
import sys

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src"])
env.Append(CCFLAGS=["-fobjc-arc"])

sources = [
    "src/register_types.cpp",
    "src/PocketPartyBLE.mm",
]

target_path = "bin/libPocketPartyBLE.{}.{}.{}".format(
    env["platform"], env["target"], env["arch"]
)

library = env.StaticLibrary(target=target_path, source=sources)
Default(library)
