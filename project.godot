; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Pocket Party"
run/main_scene="res://menu/Splash.tscn"
boot_splash/bg_color=Color(0.0313726, 0.105882, 0.615686, 1)
boot_splash/image="res://assets/branding/splash.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=2
boot_splash/use_filter=true
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/pp-icon.png"

[autoload]

PartyNetworkBridge="*res://autoload/PartyNetworkBridge.gd"
SensorGestureController="*res://autoload/SensorGestureController.gd"

[display]

window/size/viewport_width=420
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

environment/defaults/default_clear_color=Color(0.0313726, 0.105882, 0.615686, 1)
textures/vram_compression/import_etc2_astc=true
